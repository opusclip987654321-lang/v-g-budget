# Copier dans /etc/vegebudget.env sur le serveur (jamais dans le dépôt).

# Adresse publique du site, sans barre finale
SITE_ORIGIN=https://www.mon-domaine.fr
# Dossier de la base SQLite et des photos (à sauvegarder)
DATA_DIR=/var/lib/vegebudget
# Secret de signature des sessions : 32 caractères ou plus (openssl rand -base64 48)
AUTH_SECRET=
# Seule cette adresse peut ouvrir l'espace de gestion
OWNER_EMAIL=
# Secret de la tâche planifiée qui envoie le rappel hebdomadaire (openssl rand -hex 24)
CRON_SECRET=

# Envoi des liens de connexion (compte e-mail OVH)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=bonjour@mon-domaine.fr
SMTP_PASSWORD=
EMAIL_FROM=VégéBudget <bonjour@mon-domaine.fr>

# Paiements Stripe. Seule la clé secrète est nécessaire : le site crée lui-même les prix (4,99 €/mois et
# fondateur 19 €/an), l'adresse de notification et la page de gestion d'abonnement
# (espace de gestion > Ouverture > « Vérifier et préparer Stripe »).
# Clé sk_test_… pour essayer avec la carte 4242 4242 4242 4242, puis sk_live_… pour les vrais paiements.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
# Facultatif : secret d'une adresse de notification créée à la main dans Stripe (sinon créée par le site).
STRIPE_WEBHOOK_SECRET=

# Facultatif : codes de vérification Google Search Console et Bing Webmaster Tools (méthode balise)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

PORT=3000

# Chiffres de fréquentation lus par le cerveau (GET /api/stats). Vide = CRON_SECRET.
STATS_TOKEN=

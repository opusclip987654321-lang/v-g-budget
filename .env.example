# Copier dans /etc/vegebudget.env sur le serveur (jamais dans le dépôt).

# Adresse publique du site, sans barre finale
SITE_ORIGIN=https://www.mon-domaine.fr
# Dossier de la base SQLite et des photos (à sauvegarder)
DATA_DIR=/var/lib/vegebudget
# Secret de signature des sessions : 32 caractères ou plus (openssl rand -base64 48)
AUTH_SECRET=
# Seule cette adresse peut ouvrir l'espace de gestion
OWNER_EMAIL=
# Secret de la tâche planifiée qui envoie le rappel hebdomadaire (openssl rand -hex 24)
CRON_SECRET=

# Envoi des liens de connexion (compte e-mail OVH)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=bonjour@mon-domaine.fr
SMTP_PASSWORD=
EMAIL_FROM=VégéBudget <bonjour@mon-domaine.fr>

# Paiements (laisser désactivé tant que Stripe n'est pas configuré et testé)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Facultatif : codes de vérification Google Search Console et Bing Webmaster Tools (méthode balise)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

PORT=3000
